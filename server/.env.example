# ===== Server =====
# URL publik server. Spotify redirect URI = PUBLIC_URL + /callback (daftarkan persis sama di Spotify Dashboard)
#   Lokal (login dari komputer yang sama): http://127.0.0.1:8888
#   VPS/Coolify:                           https://lirik.domainanda.com
PUBLIC_URL=http://127.0.0.1:8888
PORT=8888

# Kunci rahasia antara app iPhone dan server (minimal 16 karakter). Buat: openssl rand -hex 24
API_KEY=ganti-dengan-string-acak-panjang

# Folder penyimpanan token (di Docker/Coolify monorepo: DATA_DIR=/data + persistent volume)
DATA_DIR=./data

# ===== Spotify (developer.spotify.com/dashboard) =====
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ===== Apple Push Notification (developer.apple.com → Keys → APNs) =====
# Set 1 untuk mencoba tanpa APNs: push hanya dicetak ke log
APNS_DRY_RUN=0
# development = build dari Xcode ke iPhone, production = TestFlight/App Store
APNS_ENV=development
APNS_TEAM_ID=
APNS_KEY_ID=
# Bundle ID app utama (BUKAN bundle widget), contoh: com.rofiq.lirikisland
APNS_BUNDLE_ID=
# Pilih salah satu: path file .p8, atau isi file .p8 dalam base64 (praktis untuk Coolify)
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# APNS_KEY_BASE64=

# ===== Penyetelan (opsional) =====
# Polling Spotify saat lagu diputar / saat diam (ms)
POLL_MS=3000
IDLE_POLL_MS=10000
# Kirim push sekian ms lebih awal untuk menutup delay jaringan. Lirik telat → naikkan; kecepatan → turunkan
LEAD_MS=400
# Jarak minimum antar push (ms)
MIN_PUSH_INTERVAL_MS=1000
# Akhiri Live Activity otomatis setelah sekian menit tanpa musik (0 = tidak pernah)
AUTO_END_IDLE_MIN=15
# 1 = catat setiap push sukses di log (untuk mengukur jatah push iOS)
LOG_PUSHES=0
